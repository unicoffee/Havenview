# Havenview — environment configuration (example)
#
# Copy this file to `.env` and fill in any values you have.
# Every variable here is OPTIONAL. The monitor runs read-only with or
# without them; missing keys simply disable the corresponding data source
# or alert channel.
#
# NEVER commit your real .env file. It is gitignored.

# Optional: Kalshi API key, used only to READ prediction-market quotes
# (e.g. event probabilities for catalyst watches). Read-only access is
# sufficient — Havenview never places orders.
KALSHI_API_KEY=

# Optional: outbound webhook URL for pushing alerts (Slack/Discord/ntfy/etc.).
# Alerts-out only. If unset, alerts are written to the local database and logs.
PUSH_WEBHOOK_URL=
